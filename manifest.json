{
  "manifest_version": 3,
  "name": "No Propaganda on Facebook",
  "version": "0.1.0",
  "description": "Challenge claims in your Facebook feed with counterevidence and context.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "No Propaganda settings"
  }
}
